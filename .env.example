# Copy to .env and put the key in that local file. Never commit the real key.
SERPAPI_API_KEY=
# FlightAware AeroAPI: keep the key server-side. Only the standard flights lookup is used.
AEROAPI_API_KEY=
# Conservative local attempt cap per rolling 31 days, including failed attempts.
AEROAPI_REQUEST_LIMIT=100
# Local limits can be reduced, but cannot exceed the selected free allowance.
SERPAPI_SEARCH_LIMIT=250
HISTORY_MONTHS=24
APP_TIMEZONE=America/New_York
NWS_USER_AGENT="DelayAware/0.1 (local development)"
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
# Alternative installed model: devstral:24b
